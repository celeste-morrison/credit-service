# Settings for running the app or tests on your host (outside docker compose).
# Copy to .env and adjust. Containers get their own values from docker-compose.yml.

# directConnection=true: the replica set advertises "mongo:27017", which the host can't resolve.
CREDITS_MONGO_URL=mongodb://localhost:27017/?directConnection=true
CREDITS_MONGO_DB=credits
CREDITS_REDIS_URL=redis://localhost:6379/0
CREDITS_LOG_LEVEL=INFO

# Host ports published by docker compose (change if they clash with local services).
MONGO_PORT=27017
REDIS_PORT=6379
API_PORT=8000
